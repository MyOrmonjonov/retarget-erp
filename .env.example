# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
DATABASE_URL=jdbc:postgresql://localhost:5432/crm
DATABASE_USERNAME=crm
DATABASE_PASSWORD=crm

# BotFather token for the Telegram bot / Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RetargetErpBot
# HTTPS URL of the deployed frontend (Telegram requires HTTPS for production Mini Apps)
TELEGRAM_MINI_APP_URL=http://localhost:5173

# Same origin as TELEGRAM_MINI_APP_URL above (scheme+host[:port], no trailing slash/path) -
# must be set for a real deploy or every API request from the Mini App gets rejected with a
# CORS 403 before it reaches a controller. Not needed for plain localhost dev (already allowed).
FRONTEND_ORIGIN=

# Random string, at least 32 characters, used to sign session tokens
APP_AUTH_SECRET=

# Unused by the current self-service signup flow (every brand-new Telegram user gets their own
# workspace automatically on first login) - kept only so existing deploys don't break on a
# missing env var. Safe to leave blank.
BOOTSTRAP_OWNER_TELEGRAM_ID=

# First admin-panel (/admin) login, created once on startup if no admin exists yet. Leave blank
# after the first admin is created - they stay unused (AdminBootstrapRunner is a no-op once any
# admin_users row exists).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

UPLOAD_DIRECTORY=./data/uploads

# Voice-to-task AI provider (optional, pick one and set its key): gemini | openrouter | groq | yandex | selfhosted
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
